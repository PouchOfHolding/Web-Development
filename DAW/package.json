{
  "name": "fullstack-monorepo-template",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  },
  "description": "Template repository for DAW",
  "main": "index.js",
  "dependencies": {
    "ansi-regex": "^6.4.0",
    "ansi-styles": "^6.2.3",
    "backend": "^1.0.0",
    "chalk": "^5.6.2",
    "cliui": "^9.0.1",
    "emoji-regex": "^10.6.0",
    "escalade": "^3.2.0",
    "frontend": "^1.0.0",
    "get-caller-file": "^2.0.5",
    "get-east-asian-width": "^1.7.0",
    "rxjs": "^7.8.2",
    "shell-quote": "^1.9.0",
    "string-width": "^7.2.0",
    "strip-ansi": "^7.2.0",
    "supports-color": "^10.2.2",
    "tree-kill": "^1.2.2",
    "tslib": "^2.8.1",
    "wrap-ansi": "^9.0.2",
    "y18n": "^5.0.8",
    "yargs": "^18.0.0",
    "yargs-parser": "^22.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
